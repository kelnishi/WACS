<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>9</LangVersion>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>Wacs.Transpiler</RootNamespace>
        <AssemblyName>Wacs.Transpiler</AssemblyName>
        <StartupObject>Wacs.Transpiler.Cli.Program</StartupObject>

        <!-- Package identity. DEPRECATED — replaced by WACS.Cli.
             The package stays installable so existing pipelines
             keep working, but ships a stderr deprecation banner on
             every invocation pointing at `wacs`. -->
        <PackageId>WACS.Transpiler</PackageId>
        <Title>WACS Transpiler (deprecated)</Title>
        <Version>0.3.1</Version>
        <AssemblyVersion>0.3.1</AssemblyVersion>
        <Authors>Kelvin Nishikawa</Authors>
        <Copyright>(c) 2025 Kelvin Nishikawa</Copyright>
        <Description>DEPRECATED — superseded by WACS.Cli (command: `wacs`). Install with: dotnet tool install -g WACS.Cli. Original: ahead-of-time WebAssembly-to-.NET IL transpiler for WACS. Installs the `wasm-transpile` CLI tool. For programmatic use, reference WACS.Transpiler.Lib.</Description>

        <!-- Surface the deprecation in the NuGet UI: the official
             <PackageDeprecation> element isn't authored at .nuspec
             time (it's set server-side via push metadata), but this
             reason text gets baked into the package description so
             the gallery prominently displays the migration path. -->
        <PackageDeprecationReason>Replaced by WACS.Cli (command: wacs). Install with: dotnet tool install -g WACS.Cli</PackageDeprecationReason>
        <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageTags>wasm;webassembly;transpiler;aot;wacs;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- dotnet tool -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>wasm-transpile</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md">
            <Pack>true</Pack>
            <PackagePath/>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wacs.Transpiler.Lib\Wacs.Transpiler.Lib.csproj" />
        <!-- Pulled in so component-mode emit-main + wasip2 can
             reflect the WasiPreview2Bundle and its DI registration
             from the bundled CLI. ExcludeAssets=compile keeps
             these out of the public API surface; only the
             apphost ships them. -->
        <ProjectReference Include="..\Wacs.WASI.Preview2\Wacs.WASI.Preview2.csproj"
                          ExcludeAssets="compile" />
        <ProjectReference Include="..\Wacs.WASI.Preview2.DependencyInjection\Wacs.WASI.Preview2.DependencyInjection.csproj"
                          ExcludeAssets="compile" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <!-- Bundles the DI implementation alongside the apphost so
             component emit-main can build the WasiPreview2Bundle
             at runtime via WasiPreview2ServiceCollectionExtensions
             without an extra install step. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                          Version="8.0.0" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <Title>WebAssembly Spec Wast Test suite harness</Title>
        <Authors>Kelvin Nishikawa</Authors>
        <Company>Kelvin Nishikawa</Company>
        <Product>Spec.Test</Product>
        <AssemblyVersion>1.0.1</AssemblyVersion>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;STRICT_EXECUTION</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <None Include="testsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <!-- Spec.Test stays sequential. The InstLocalGet /
             InstI32Const intern-cache race fix in this PR
             stopped the parser-level tearing the other suites
             hit, but Spec.Test exercises a much broader
             surface — switch-runtime + GeneratedDispatcher +
             thousands of wast fixtures — and at default
             parallelism still surfaces a native testhost
             crash on Linux CI (see
             https://github.com/kelnishi/WACS/actions/runs/25525376634).
             Audit the additional static state in a follow-up
             before flipping this; the parser-level fix is
             still independently valuable. -->
        <None Include="xunit.runner.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
      Auto-generated wit-bindgen-csharp output in
      components/fixtures/<fixture>/{reference,expected}/ uses C# 10
      file-scoped namespaces and unsafe code. Those trees ride along
      as on-disk references for fixture diffing — they are never
      compiled into Spec.Test (`LangVersion=9`, no AllowUnsafeBlocks).
      Exclude them from the default **/*.cs glob so they don't break
      the build.
    -->
    <ItemGroup>
      <Compile Remove="components/fixtures/**/reference/**/*.cs" />
      <Compile Remove="components/fixtures/**/expected/**/*.cs" />
      <None Remove="components/fixtures/**/reference/**/*.cs" />
      <None Remove="components/fixtures/**/expected/**/*.cs" />
      <!-- wit-harness fixtures ship their own csproj subprojects
           (Aot.Spike, Generated.Validate). Exclude their .cs from
           Spec.Test's globs so they don't pollute the test assembly. -->
      <Compile Remove="components/fixtures/wit-harness-spike-*/**/*.cs" />
      <None Remove="components/fixtures/wit-harness-spike-*/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Wacs.Core\Wacs.Core\Wacs.Core.csproj" />
      <ProjectReference Include="..\Wacs.WASI\Wacs.WASI.Preview1\Wacs.WASI.Preview1\Wacs.WASI.Preview1.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
      <PackageReference Include="xunit" Version="2.9.2" />
      <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>

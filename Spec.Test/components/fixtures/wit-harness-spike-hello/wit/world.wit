package wacs:harness-spike;

/// Minimal component-model surface for the WIT-harness AOT
/// spike. Single function export over primitive types only —
/// the simplest possible exercise of canonical-ABI string
/// lower (parameter) + lift (return) at a component boundary.
world hello {
    /// Build a greeting string from the given name.
    export greet: func(name: string) -> string;
}

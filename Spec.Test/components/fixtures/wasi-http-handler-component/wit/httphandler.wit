package local:httphandler;
world demo {
    import wasi:http/types@0.2.8;
    import wasi:http/outgoing-handler@0.2.8;
    /// Calls handle(req, None); drops the returned future.
    /// Returns the outer disc byte (0 = Ok).
    export ask-handle-none: func(req: u32) -> u32;
    /// Calls handle(req, Some(opts)); drops the future.
    /// Returns the outer disc byte (0 = Ok).
    export ask-handle-some: func(req: u32, opts: u32) -> u32;
}

package local:httpbody;
world demo {
    import wasi:http/types@0.2.8;
    /// Calls outgoing-request.body(handle) → outgoing-body
    /// → write() → output-stream. Drops everything. Returns
    /// the outer disc byte from the final body() call (0=Ok).
    export ask-write-chain: func(handle: u32) -> u32;
    /// Calls incoming-response.consume(handle) → incoming-body
    /// → stream() → input-stream. Drops everything. Returns
    /// the outer disc byte (0=Ok).
    export ask-read-chain: func(handle: u32) -> u32;
}

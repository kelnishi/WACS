package local:futuretrailers;
world demo {
    import wasi:http/types@0.2.3;
    /// Calls future-trailers.get(handle); returns the outer
    /// option disc byte (0 = None / not ready, 1 = Some).
    export ask-outer-disc: func(ft: u32) -> u32;
    /// Calls future-trailers.get(handle); returns the result
    /// disc byte at offset 8 (0 = Ok, 1 = Err).
    export ask-result-disc: func(ft: u32) -> u32;
    /// Calls future-trailers.get(handle); returns the inner
    /// option disc byte at offset 16 (0 = None, 1 = Some).
    export ask-inner-disc: func(ft: u32) -> u32;
    /// Calls future-trailers.get(handle); returns the trailers
    /// handle at offset 20 (only valid when inner disc is 1).
    export ask-trailers-handle: func(ft: u32) -> u32;
}

package wasi:filesystem@0.2.8;
interface types {
    enum error-code { unknown }
    flags descriptor-flags {
        read,
        write,
        file-integrity-sync,
        data-integrity-sync,
        requested-write-sync,
        mutate-directory,
    }
    resource descriptor {
        get-flags: func() -> result<descriptor-flags, error-code>;
    }
}

package local:httprequest;
world demo {
    import wasi:http/types@0.2.3;
    /// Calls path-with-query; returns the option-disc byte
    /// (0=None, 1=Some) packed with the first byte of the
    /// returned string at bits 8-15.
    export ask-path: func(handle: u32) -> u32;
    /// Calls authority; returns option-disc + first byte.
    export ask-authority: func(handle: u32) -> u32;
}

package local:fsmutate;
world demo {
    import wasi:filesystem/types@0.2.8;
    /// Calls create-directory-at, remove-directory-at, and
    /// unlink-file-at — each with the same path string. Returns
    /// the outer disc summed across all three (always-Ok = 0).
    export ask-mutate: func(handle: u32) -> u32;
}

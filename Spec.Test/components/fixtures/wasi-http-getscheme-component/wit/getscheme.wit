package local:getscheme;
world demo {
    import wasi:http/types@0.2.8;
    /// Calls outgoing-request.scheme(handle); returns the
    /// outer option disc byte (0=None, 1=Some).
    export ask-scheme-disc: func(req: u32) -> u32;
    /// Calls outgoing-request.scheme(handle); returns the
    /// inner variant disc byte (only valid when option=Some).
    export ask-scheme-variant: func(req: u32) -> u32;
    /// Calls outgoing-request.scheme(handle); returns the
    /// inner-variant string len for Other(string), or 0
    /// otherwise.
    export ask-scheme-other-len: func(req: u32) -> u32;
}

package local:fsread;
world demo {
    import wasi:filesystem/types@0.2.8;
    import wasi:io/streams@0.2.8;
    /// Calls descriptor.read-via-stream(handle, 0), reads up
    /// to len bytes via the resulting input-stream, returns
    /// the actual byte count read.
    export read-first: func(handle: u32, len: u64) -> u32;
}

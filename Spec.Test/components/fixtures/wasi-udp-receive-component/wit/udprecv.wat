(module
  (import "wasi:sockets/udp@0.2.8" "[method]incoming-datagram-stream.receive"
    (func $rcv (param i32 i64 i32)))
  (memory (export "memory") 1)
  (global $next (mut i32) (i32.const 1024))
  (func $realloc (param i32 i32 i32 i32) (result i32)
    (local $r i32) (local $align i32)
    (local.set $align (local.get 2))
    (global.set $next
      (i32.and
        (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
        (i32.xor (i32.const -1) (i32.sub (local.get $align) (i32.const 1)))))
    (local.set $r (global.get $next))
    (global.set $next
      (i32.add (global.get $next) (local.get 3)))
    (local.get $r))
  (export "cabi_realloc" (func $realloc))
  (func (export "ask-recv-count") (param i32) (result i32)
    (local $r i32)
    ;; result<list<datagram>, _>: align 4, total 12 (1 disc + 3 pad + 8 list)
    (local.set $r (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 12)))
    (call $rcv (local.get 0) (i64.const 4) (local.get $r))
    (i32.load offset=8 (local.get $r)))
  (func (export "ask-recv-first-data-len") (param i32) (result i32)
    (local $r i32) (local $arr i32)
    (local.set $r (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 12)))
    (call $rcv (local.get 0) (i64.const 4) (local.get $r))
    ;; array ptr at retArea+4
    (local.set $arr (i32.load offset=4 (local.get $r)))
    ;; First elem at arr+0; data-len at +4
    (i32.load offset=4 (local.get $arr)))
  (func (export "ask-recv-first-data-byte") (param i32) (result i32)
    (local $r i32) (local $arr i32) (local $dataPtr i32)
    (local.set $r (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 12)))
    (call $rcv (local.get 0) (i64.const 4) (local.get $r))
    (local.set $arr (i32.load offset=4 (local.get $r)))
    (local.set $dataPtr (i32.load (local.get $arr)))
    (i32.load8_u (local.get $dataPtr)))
  (func (export "ask-recv-first-port") (param i32) (result i32)
    (local $r i32) (local $arr i32)
    (local.set $r (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 12)))
    (call $rcv (local.get 0) (i64.const 4) (local.get $r))
    (local.set $arr (i32.load offset=4 (local.get $r)))
    ;; Elem layout:
    ;;   +0: data-ptr, +4: data-len   (8 bytes)
    ;;   +8: variant disc + padding   (variant base)
    ;;   +12: port (u16)              (variant payload start)
    (i32.load16_u offset=12 (local.get $arr))))

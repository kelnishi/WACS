package local:httpresponseoutparam;
world demo {
    import wasi:http/types@0.2.3;
    /// Calls [static]response-outparam.set(param, Ok(response)).
    /// Returns 0 (no canon return; wasm just exits cleanly if
    /// the call succeeds).
    export ask-set-ok: func(param: u32, response: u32) -> u32;
    /// Calls [static]response-outparam.set(param, Err(internal-error)).
    /// Returns 0 if the call doesn't trap.
    export ask-set-err: func(param: u32) -> u32;
}

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <Title>WACS WASI Preview 3 — DI extensions</Title>
        <PackageId>WACS.WASI.Preview3.DependencyInjection</PackageId>
        <Authors>Kelvin Nishikawa</Authors>
        <Description>Microsoft.Extensions.DependencyInjection extension methods for WACS.WASI.Preview3. Registers default host implementations + a pre-wired host suite.</Description>
        <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
        <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <AssemblyName>Wacs.WASI.Preview3.DependencyInjection</AssemblyName>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <Version>0.1.0</Version>
        <RepositoryType>git</RepositoryType>
        <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
        <ProjectReference Include="..\Wacs.WASI.Preview3\Wacs.WASI.Preview3.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md">
            <Pack>true</Pack>
            <PackagePath/>
        </None>
    </ItemGroup>

</Project>

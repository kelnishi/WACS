<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <Title>Wacs WASI-NN TorchSharp backend</Title>
        <PackageId>WACS.WASI.NN.TorchSharp</PackageId>
        <Authors>Kelvin Nishikawa</Authors>
        <Description>TorchSharp / libtorch backend for WACS.WASI.NN. Implements GraphEncoding.PyTorch — load TorchScript modules from byte buffers (graph.load) or by name (graph.load-by-name), run inference through libtorch's C++ runtime. CPU default; swap LibTorch backend NuGets for CUDA / ROCm / MPS without source change.</Description>
        <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
        <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <AssemblyName>Wacs.WASI.NN.TorchSharp</AssemblyName>
        <AssemblyVersion>0.1.1</AssemblyVersion>
        <Version>0.1.1</Version>
        <RepositoryType>git</RepositoryType>
        <TargetFramework>net8.0</TargetFramework>
        <PackageTags>wasm;wasi;nn;ml;pytorch;torchsharp;libtorch;wacs</PackageTags>
        <!-- Same packaging shape as the LlamaSharp / MLNet backends:
             this assembly is loaded via `wacs run [bind] <path>`'s
             Assembly.LoadFrom (the embedder-supplies-the-backend
             flow). EnableDynamicLoading copies every transitive
             NuGet (TorchSharp + libtorch-cpu's RID-specific
             ~700 MB native runtimes) into the project's bin so
             the LoadFromContext resolver can satisfy them
             locally without TPA / NuGet-cache probing. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md">
            <Pack>true</Pack>
            <PackagePath/>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wacs.WASI.NN\Wacs.WASI.NN.csproj" />
        <!-- TorchSharp-cpu is a meta-package that pulls both
             TorchSharp (managed bindings) AND the matching
             libtorch-cpu native runtime in one go. Embedders
             that want CUDA / ROCm / MPS swap this for
             TorchSharp-cuda-12.1 / -rocm / -macos-x64 — no
             source change required. -->
        <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
    </ItemGroup>

    <!-- Gap 29 / round-24 verification: upstream `libtorch-cpu`
         on osx-arm64 has a hardcoded LC_LOAD_DYLIB entry pointing
         at `/opt/homebrew/opt/libomp/lib/libomp.dylib` (a Homebrew
         install path) instead of `@loader_path/libomp.dylib`. The
         bundled `libomp.dylib` from the same NuGet sits next to
         libtorch_cpu.dylib in `runtimes/osx-arm64/native/`, but
         dyld resolves the absolute path first and misses it on
         hosts without Homebrew libomp installed (most CI machines,
         fresh dev installs).
         Post-process the dylib at build time: rewrite the
         LC_LOAD_DYLIB entry to `@loader_path/libomp.dylib` so the
         loader picks up the bundled libomp regardless of the
         host's Homebrew state. install_name_tool ships with
         every macOS install (Xcode CLI tools / SDK). Idempotent —
         re-runs are no-ops once the entry is rewritten. -->
    <Target Name="RewriteLibompRpathOnOsxArm64"
            AfterTargets="Build"
            Condition="'$(OS)' == 'Unix'">
        <PropertyGroup>
            <_LibTorchCpuDylib>$(OutDir)runtimes/osx-arm64/native/libtorch_cpu.dylib</_LibTorchCpuDylib>
            <_HomebrewLibompPath>/opt/homebrew/opt/libomp/lib/libomp.dylib</_HomebrewLibompPath>
        </PropertyGroup>
        <Exec Command="install_name_tool -change &quot;$(_HomebrewLibompPath)&quot; &quot;@loader_path/libomp.dylib&quot; &quot;$(_LibTorchCpuDylib)&quot; 2&gt;/dev/null || true"
              Condition="Exists('$(_LibTorchCpuDylib)')"
              IgnoreExitCode="true" />
    </Target>

</Project>

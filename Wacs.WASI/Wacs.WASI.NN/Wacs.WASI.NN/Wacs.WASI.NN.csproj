<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <Title>Wacs WASI Neural Network</Title>
        <PackageId>WACS.WASI.NN</PackageId>
        <Authors>Kelvin Nishikawa</Authors>
        <Description>WASI-NN host bindings for WACS — wasi:nn@0.2.0-rc-2024-10-28 (component-model WIT) plus the legacy wasi_ephemeral_nn (WITX) ABI. Backend-agnostic core; pluggable backends (ML.NET, ONNX Runtime, LlamaSharp) ship as sibling packages.</Description>
        <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
        <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <AssemblyName>Wacs.WASI.NN</AssemblyName>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <Version>0.1.0</Version>
        <RepositoryType>git</RepositoryType>
        <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
        <PackageTags>wasm;webassembly;wasi;nn;ml;wacs</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Wacs.Core\Wacs.Core\Wacs.Core.csproj" />
        <ProjectReference Include="..\..\..\Wacs.ComponentModel\Wacs.ComponentModel\Wacs.ComponentModel.csproj" />
        <ProjectReference Include="..\..\..\Wacs.HostBindings\Wacs.HostBindings.Abstractions\Wacs.HostBindings.Abstractions.csproj" />
    </ItemGroup>

    <!-- Vendored upstream wasi-nn spec files. Embedded so the assembly
         is self-contained — downstream tools (Linker.Validate, the
         WIT-driven SourceGen if/when it consumes nn) can read them
         without requiring the wit/ tree on disk. -->
    <ItemGroup>
        <EmbeddedResource Include="wit\**\*.wit;wit\**\*.witx"
                          LogicalName="wit/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="wit\deps.lock" Pack="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wacs.WASI.NN.Test" />
        <InternalsVisibleTo Include="Wacs.WASI.NN.MLNet" />
        <InternalsVisibleTo Include="Wacs.WASI.NN.OnnxRuntime" />
        <InternalsVisibleTo Include="Wacs.WASI.NN.LlamaSharp" />
    </ItemGroup>

</Project>

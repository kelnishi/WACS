<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>9</LangVersion>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>Wacs.ComponentModel.Bindgen.Cli</RootNamespace>
        <AssemblyName>Wacs.ComponentModel.Bindgen</AssemblyName>
        <StartupObject>Wacs.ComponentModel.Bindgen.Cli.Program</StartupObject>

        <!-- Package identity. DEPRECATED — superseded by the
             `wacs bindgen` verb in WACS.Cli. The package stays
             installable so existing pipelines keep working, but
             ships a stderr deprecation banner on every invocation. -->
        <PackageId>WACS.ComponentModel.Bindgen</PackageId>
        <Title>WACS Component Model Bindgen (deprecated)</Title>
        <Version>0.1.1</Version>
        <AssemblyVersion>0.1.1</AssemblyVersion>
        <Authors>Kelvin Nishikawa</Authors>
        <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
        <Description>DEPRECATED — superseded by `wacs bindgen` in WACS.Cli (install with: dotnet tool install -g WACS.Cli). Original: WIT → C# binding generator for WACS components. For programmatic use, reference WACS.ComponentModel.Bindgen.Lib (still maintained).</Description>
        <PackageDeprecationReason>Replaced by `wacs bindgen` verb in WACS.Cli. Install with: dotnet tool install -g WACS.Cli</PackageDeprecationReason>
        <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageTags>wasm;webassembly;component-model;wit;bindgen;wacs;dotnet-tool</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- dotnet tool -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>wit-bindgen-wacs</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wacs.ComponentModel.Bindgen.Lib\Wacs.ComponentModel.Bindgen.Lib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
    </ItemGroup>

</Project>

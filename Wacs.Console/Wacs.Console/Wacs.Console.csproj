<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>9</LangVersion>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <!--
      PublishAot/PublishTrimmed pin IsDynamicCodeSupported=false via AOT
      analyzers even during `dotnet run`. That breaks the runtime
      Reflection.Emit path behind the new aot flag. Gate on
      _IsPublishing so dev builds keep dynamic-code support, and
      `dotnet publish` still produces the fully-AOT standalone binary.
    -->
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <PublishTrimmed Condition="'$(_IsPublishing)' == 'true'">true</PublishTrimmed>

    <Company>Kelvin Nishikawa</Company>
    <Authors>Kelvin Nishikawa</Authors>
    <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
    <Product>WACS</Product>

    <!-- Package identity: ships as the unified `wacs` global tool that
         supersedes wasm-transpile (WACS.Transpiler). The PackageId is
         WACS.Cli (the bare WACS id is owned by Wacs.Core, the runtime
         library); the tool command users type is still `wacs`. -->
    <PackageId>WACS.Cli</PackageId>
    <Title>WACS CLI</Title>
    <Version>1.5.15</Version>
    <AssemblyVersion>1.5.15</AssemblyVersion>
    <FileVersion>1.4.1</FileVersion>
    <Description>WACS unified WebAssembly toolchain: run, build, aot, inspect, bindgen. v1.3 picks up WACS.Transpiler.Lib v0.7's PersistedAssemblyBuilder migration + RVA-mapped data segments, so `wacs build` produces ~11% smaller .dlls and the new EmissionTarget.Auto default cuts cold start by ~50% on the common module shapes. The `wacs aot` verb produces self-contained NativeAOT native binaries from a wasm input in one shot, with --wasi / --wasip2 baking in WASI Preview 1 / Preview 2 hosts. Supersedes wasm-transpile (WACS.Transpiler).</Description>
    <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>wasm;webassembly;wacs;component-model;wasi;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- dotnet tool -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wacs</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE;STRICT_EXECUTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>true</Pack>
      <PackagePath/>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Wacs.Core\Wacs.Core\Wacs.Core.csproj" />
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.Preview1\Wacs.WASI.Preview1\Wacs.WASI.Preview1.csproj" />
    <ProjectReference Include="..\..\Wacs.Transpiler\Wacs.Transpiler.Lib\Wacs.Transpiler.Lib.csproj" />
    <!-- Powers the `wacs bindgen` verb (WIT ↔ C# binding
         generation, forward + reverse). The standalone
         WACS.ComponentModel.Bindgen tool (`wit-bindgen-wacs`) is
         deprecated in favor of this verb. -->
    <ProjectReference Include="..\..\Wacs.ComponentModel\Wacs.ComponentModel.Bindgen.Lib\Wacs.ComponentModel.Bindgen.Lib.csproj" />
    <!-- Compile-referenced so RunHandler can construct the typed
         WasiPreview2RuntimeScope (which owns the DI scope that
         pre-binds every *Bindings.BindToRuntime against the
         transpiler's runtime — closing the
         direct-link-vs-BindHostFunction gap from
         wasi-nn/WACS-GAPS.md round 3 issue 9).
         The save-to-dll emit-main path still loads them
         reflectively via Assembly.Load. -->
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.Preview2\Wacs.WASI.Preview2\Wacs.WASI.Preview2.csproj" />
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.Preview2\Wacs.WASI.Preview2.DependencyInjection\Wacs.WASI.Preview2.DependencyInjection.csproj" />
    <!-- Bundled so the wasi-nn flag resolves the DLL via
         Assembly.Load without spelling out a filesystem path.
         The ONNX Runtime native binaries (~50 MB across RIDs)
         ride along; the cost embedders pay for the
         out-of-box wasi-nn UX on stock command components. -->
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.NN\Wacs.WASI.NN\Wacs.WASI.NN.csproj"
                      ExcludeAssets="compile" />
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.NN\Wacs.WASI.NN.OnnxRuntime\Wacs.WASI.NN.OnnxRuntime.csproj"
                      ExcludeAssets="compile" />
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.NN\Wacs.WASI.NN.DependencyInjection\Wacs.WASI.NN.DependencyInjection.csproj"
                      ExcludeAssets="compile" />
    <!-- Bundled so the wasi-threads flag resolves the DLL
         via Assembly.Load without spelling out a filesystem
         path. The Threads package is small (no native binaries)
         and useful enough to ship by default. -->
    <ProjectReference Include="..\..\Wacs.WASI\Wacs.WASI.Threads\Wacs.WASI.Threads\Wacs.WASI.Threads.csproj"
                      ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="JetBrains.Profiler.Api" Version="1.4.8" />
    <!-- Pulled in so component-mode build/run emit-main can build
         WasiPreview2Bundle via WasiPreview2ServiceCollectionExtensions
         without an extra install step. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                      Version="8.0.0" />
  </ItemGroup>

</Project>

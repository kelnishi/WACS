<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>9</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <!--
      PublishAot/PublishTrimmed pin IsDynamicCodeSupported=false via AOT
      analyzers even during `dotnet run`. That breaks the runtime
      Reflection.Emit path behind the new aot flag. Gate on
      _IsPublishing so dev builds keep dynamic-code support, and
      `dotnet publish` still produces the fully-AOT standalone binary.
    -->
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <PublishTrimmed Condition="'$(_IsPublishing)' == 'true'">true</PublishTrimmed>

    <Company>Kelvin Nishikawa</Company>
    <Authors>Kelvin Nishikawa</Authors>
    <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
    <Product>WACS</Product>

    <!-- Package identity: ships as the unified `wacs` global tool that
         supersedes wasm-transpile (WACS.Transpiler). The PackageId is
         WACS.Cli (the bare WACS id is owned by Wacs.Core, the runtime
         library); the tool command users type is still `wacs`. -->
    <PackageId>WACS.Cli</PackageId>
    <Title>WACS CLI</Title>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <Description>WACS unified WebAssembly toolchain: run, build, inspect, bindgen. Supersedes wasm-transpile (WACS.Transpiler) and wit-bindgen-wacs (WACS.ComponentModel.Bindgen).</Description>
    <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>wasm;webassembly;wacs;component-model;wasi;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- dotnet tool -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wacs</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE;STRICT_EXECUTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>true</Pack>
      <PackagePath/>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wacs.Core\Wacs.Core.csproj" />
    <ProjectReference Include="..\Wacs.WASIp1\Wacs.WASIp1.csproj" />
    <ProjectReference Include="..\Wacs.Transpiler.Lib\Wacs.Transpiler.Lib.csproj" />
    <!-- Powers the `wacs bindgen` verb (WIT ↔ C# binding
         generation, forward + reverse). The standalone
         WACS.ComponentModel.Bindgen tool (`wit-bindgen-wacs`) is
         deprecated in favor of this verb. -->
    <ProjectReference Include="..\Wacs.ComponentModel.Bindgen.Lib\Wacs.ComponentModel.Bindgen.Lib.csproj" />
    <!-- Bundled with the apphost so component-mode emit-main can
         reflectively construct WasiPreview2Bundle at runtime via
         AddWasiPreview2(). ExcludeAssets=compile keeps these out
         of the public API surface; only the apphost ships them. -->
    <ProjectReference Include="..\Wacs.WASI.Preview2\Wacs.WASI.Preview2.csproj"
                      ExcludeAssets="compile" />
    <ProjectReference Include="..\Wacs.WASI.Preview2.DependencyInjection\Wacs.WASI.Preview2.DependencyInjection.csproj"
                      ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="JetBrains.Profiler.Api" Version="1.4.8" />
    <!-- Pulled in so component-mode build/run emit-main can build
         WasiPreview2Bundle via WasiPreview2ServiceCollectionExtensions
         without an extra install step. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                      Version="8.0.0" />
  </ItemGroup>

</Project>

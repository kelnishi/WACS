<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <Title>WACS Component Model</Title>
        <PackageId>WACS.ComponentModel</PackageId>
        <Authors>Kelvin Nishikawa</Authors>
        <Description>WebAssembly Component Model support for WACS. Provides the WIT IDL parser, component types, canonical ABI lift/lower, component instantiation, and the host binding surface for running .component.wasm modules on the WACS runtime and AOT transpiler.</Description>
        <Copyright>(c) 2026 Kelvin Nishikawa</Copyright>
        <PackageProjectUrl>https://github.com/kelnishi/WACS</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kelnishi/WACS</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <AssemblyName>Wacs.ComponentModel</AssemblyName>
        <AssemblyVersion>0.8.4</AssemblyVersion>
        <Version>0.8.4</Version>
        <RepositoryType>git</RepositoryType>
        <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md">
            <Pack>true</Pack>
            <PackagePath/>
        </None>
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Wacs.Core\Wacs.Core\Wacs.Core.csproj" />
      <ProjectReference Include="..\Wacs.ComponentModel.Parser\Wacs.ComponentModel.Parser.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- System.Threading.Channels is in-box for net8.0+; netstandard2.1
           needs the package. Used by the Phase 3 StreamBuffer for the
           bounded producer/consumer half-channel that backs stream<T>. -->
      <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- Test project uses internal CSharpEmit helpers (NameConventions,
           EmitWorldShellFile and friends) to validate naming conventions
           and individual file emissions in isolation. -->
      <InternalsVisibleTo Include="Wacs.ComponentModel.Test" />
      <!-- Harness.Lib needs NameMangler (kebab → PascalCase / CamelCase)
           to derive C# identifiers from WIT names — single source of
           truth across emission paths. -->
      <InternalsVisibleTo Include="Wacs.ComponentModel.Harness.Lib" />
      <!-- Transpiler.Lib's HarnessAssemblyBinder + HarnessImplEmit
           also need NameMangler — same kebab→Pascal/Camel naming
           must agree with what Harness.Lib emitted. -->
      <InternalsVisibleTo Include="Wacs.Transpiler.Lib" />
    </ItemGroup>

</Project>
